# Copie para .env.local e ajuste. O Makefile repassa os valores ao Docker Compose; o Vite e os
# testes também leem este arquivo. Uma variável já definida no ambiente vence o .env.local.
# Porta publicada da API em 127.0.0.1 (o Vite encaminha /api para ela).
PROBE_BACKEND_PORT=3210
# Porta publicada do PostgreSQL em 127.0.0.1 (usada pelos testes e por clientes locais).
PROBE_DB_PORT=5434
# Executor (make executor), que chama o claude no WSL. O backend no Docker o alcança por
# host.docker.internal. Com Docker Desktop, 127.0.0.1 basta; com o Docker Engine instalado no
# próprio WSL, use 0.0.0.0 para o container alcançá-lo pela ponte do Docker.
PROBE_EXECUTOR_HOST=127.0.0.1
PROBE_EXECUTOR_PORT=3211
# Tempo máximo de cada chamada ao claude, em milissegundos; depois disso ela é interrompida.
PROBE_EXECUTOR_TIMEOUT_MS=300000
# Credencial técnica entre backend e executor (obrigatória). Gere com: openssl rand -hex 32
PROBE_EXECUTOR_TOKEN=
# Modelo do claude usado nas novas solicitações à IA (alias como sonnet ou nome completo).
PROBE_CLAUDE_MODEL=sonnet
